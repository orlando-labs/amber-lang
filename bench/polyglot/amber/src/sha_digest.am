def compress(hash, block, constants):
  w = zero_schedule()
  i = 0
  while i < 16:
    w[i] = block[i]
    i = i + 1
  while i < 64:
    x0 = w[i - 15]
    s0 = ((((x0 >> 7) | (x0 << 25)) & 0xffffffff) ^ (((x0 >> 18) | (x0 << 14)) & 0xffffffff)) ^ (x0 >> 3)
    x1 = w[i - 2]
    s1 = ((((x1 >> 17) | (x1 << 15)) & 0xffffffff) ^ (((x1 >> 19) | (x1 << 13)) & 0xffffffff)) ^ (x1 >> 10)
    w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & 0xffffffff
    i = i + 1

  a = hash[0]
  b = hash[1]
  c = hash[2]
  d = hash[3]
  e = hash[4]
  f = hash[5]
  g = hash[6]
  h = hash[7]

  i = 0
  while i < 64:
    s1 = ((((e >> 6) | (e << 26)) & 0xffffffff) ^ (((e >> 11) | (e << 21)) & 0xffffffff)) ^ (((e >> 25) | (e << 7)) & 0xffffffff)
    choice = (e & f) ^ ((e ^ 0xffffffff) & g)
    t1 = (h + s1 + choice + constants[i] + w[i]) & 0xffffffff
    s0 = ((((a >> 2) | (a << 30)) & 0xffffffff) ^ (((a >> 13) | (a << 19)) & 0xffffffff)) ^ (((a >> 22) | (a << 10)) & 0xffffffff)
    majority = (a & b) ^ (a & c) ^ (b & c)
    t2 = (s0 + majority) & 0xffffffff
    h = g
    g = f
    f = e
    e = (d + t1) & 0xffffffff
    d = c
    c = b
    b = a
    a = (t1 + t2) & 0xffffffff
    i = i + 1

  hash[0] = (hash[0] + a) & 0xffffffff
  hash[1] = (hash[1] + b) & 0xffffffff
  hash[2] = (hash[2] + c) & 0xffffffff
  hash[3] = (hash[3] + d) & 0xffffffff
  hash[4] = (hash[4] + e) & 0xffffffff
  hash[5] = (hash[5] + f) & 0xffffffff
  hash[6] = (hash[6] + g) & 0xffffffff
  hash[7] = (hash[7] + h) & 0xffffffff
  hash[0]

def mix_block(block, round_index):
  carry = ((round_index + 1) * 0x9e3779b1) & 0xffffffff
  i = 0
  while i < 16:
    left = block[(i + 1) % 16]
    right = block[(i + 9) % 16]
    block[i] = (block[i] + carry + (left ^ right) + ((i + 17) * (round_index + 3))) & 0xffffffff
    shift = (i % 13) + 1
    mixed = carry ^ block[i]
    carry = ((mixed >> shift) | (mixed << (32 - shift))) & 0xffffffff
    i = i + 1
  block[0]

def fold_digest(hash):
  fold = 0
  i = 0
  while i < 8:
    fold = ((fold ^ hash[i]) + ((i + 1) * 0x9e3779b1)) & 0xffffffff
    i = i + 1
  fold

def main():
  constants = round_constants()
  hash = initial_hash()
  block = initial_block()
  round_index = 0
  while round_index < 600:
    compress(hash, block, constants)
    mix_block(block, round_index)
    round_index = round_index + 1
  fold_digest(hash)

main()
